# CONFIGURACIÓN GENERAL
APP_NAME=Proyecto_Universidad
APP_ENV=development
DEBUG=true

# SERVIDOR FASTAPI
HOST=127.0.0.1
PORT=8000

# SUPABASE
SUPABASE_URL=https://TU_PROJECT_ID.supabase.co
SUPABASE_KEY=TU_SUPABASE_PUBLISHABLE_KEY

# BASE DE DATOS
DATABASE_URL=postgresql+psycopg://USUARIO:CONTRASEÑA@HOST:PUERTO/postgres?sslmode=require

# CORS
FRONTEND_URL=http://localhost:5173
# JWT / SESIÓN (generar JWT_SECRET con: python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET=CAMBIA_ESTO_POR_UN_SECRETO_LARGO
JWT_ALGORITHM=HS256
SESSION_INACTIVITY_MINUTES=30
SESSION_MAX_HOURS=12

# SMTP (envío del enlace de precotización, HU-13). Sin estos valores la app
# arranca igual; solo el envío de correo queda deshabilitado (error controlado).
# No pongas credenciales reales en este archivo de ejemplo.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@TU_DOMINIO
SMTP_TLS=true
SMTP_TIMEOUT=10
# Ruta pública de la propuesta (provisional, coordinar con el frontend)
PROPOSAL_PATH=/propuesta

# OTP de aceptación de precotización (HU-15). Secreto INDEPENDIENTE de JWT_SECRET.
# La app arranca sin este valor, pero las operaciones OTP fallan de forma
# controlada si falta o es inseguro. Generar uno seguro con:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
OTP_SECRET=