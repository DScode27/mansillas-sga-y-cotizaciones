# CONFIGURACIÓN GENERAL
APP_NAME=Proyecto_Universidad
APP_ENV=development
DEBUG=true

# SERVIDOR FASTAPI
HOST=127.0.0.1
PORT=8000

# SUPABASE
SUPABASE_URL=https://TU_PROJECT_ID.supabase.co
SUPABASE_KEY=TU_SUPABASE_PUBLISHABLE_KEY

# BASE DE DATOS
DATABASE_URL=postgresql+psycopg://USUARIO:CONTRASEÑA@HOST:PUERTO/postgres?sslmode=require

# CORS
FRONTEND_URL=http://localhost:5173
# JWT / SESIÓN (generar JWT_SECRET con: python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET=CAMBIA_ESTO_POR_UN_SECRETO_LARGO
JWT_ALGORITHM=HS256
SESSION_INACTIVITY_MINUTES=30
SESSION_MAX_HOURS=12

# SMTP (envío de correos: enlace de precotización HU-13, códigos OTP HU-15/HU-24).
# Sin estos valores la app arranca igual; solo el envío de correo queda
# deshabilitado (error controlado 503 / registro en logs en desarrollo).
# NO pongas credenciales reales en este archivo de ejemplo.
#
# --- Opción recomendada para un proyecto universitario: Gmail (gratis) ---
# 1. En la cuenta de Gmail, activa la Verificación en 2 pasos.
# 2. Entra a https://myaccount.google.com/apppasswords y genera una
#    "Contraseña de aplicación" (16 caracteres). Esa es tu SMTP_PASSWORD
#    (NO tu contraseña normal de Gmail). No cuesta nada ni pide tarjeta.
# 3. Rellena:
#      SMTP_HOST=smtp.gmail.com
#      SMTP_PORT=587
#      SMTP_USER=tucuenta@gmail.com
#      SMTP_PASSWORD=la_contraseña_de_aplicacion_de_16_caracteres
#      SMTP_FROM=tucuenta@gmail.com
#      SMTP_TLS=true
#
# --- Alternativa: Brevo (antes Sendinblue), 300 correos/día gratis sin tarjeta ---
#      SMTP_HOST=smtp-relay.brevo.com
#      SMTP_PORT=587
#      SMTP_USER=tu_usuario_smtp_de_brevo
#      SMTP_PASSWORD=tu_clave_smtp_de_brevo
#      SMTP_FROM=un_remitente_verificado_en_brevo
#      SMTP_TLS=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@TU_DOMINIO
SMTP_TLS=true
SMTP_TIMEOUT=10
#
# --- Resend (API HTTP, recomendado en PaaS que bloquean los puertos SMTP) ---
# Algunas plataformas (p. ej. el plan gratis de Render) bloquean las conexiones
# SMTP salientes (puertos 25/465/587), por lo que Gmail/Brevo por SMTP fallan
# con un error de red (OSError). Resend envía por HTTPS (puerto 443), que sí
# está permitido. Si defines RESEND_API_KEY, la app usa Resend y NO usa SMTP;
# el remitente sigue tomándose de SMTP_FROM.
#   1. Crea una cuenta en https://resend.com y genera una API key (re_...).
#   2. Usa SMTP_FROM=onboarding@resend.dev para probar sin dominio, o un
#      remitente de tu dominio verificado en Resend.
#   3. Rellena RESEND_API_KEY con la clave. NO la pongas en este archivo de
#      ejemplo (va en las variables de entorno del despliegue).
RESEND_API_KEY=
# Ruta pública de la propuesta (provisional, coordinar con el frontend)
PROPOSAL_PATH=/propuesta

# OTP de aceptación de precotización (HU-15). Secreto INDEPENDIENTE de JWT_SECRET.
# La app arranca sin este valor, pero las operaciones OTP fallan de forma
# controlada si falta o es inseguro. Generar uno seguro con:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
OTP_SECRET=