# CONFIGURACIÓN GENERAL
APP_NAME=Proyecto_Universidad
APP_ENV=development
DEBUG=true

# SERVIDOR FASTAPI
HOST=127.0.0.1
PORT=8000

# SUPABASE
SUPABASE_URL=https://TU_PROJECT_ID.supabase.co
SUPABASE_KEY=TU_SUPABASE_PUBLISHABLE_KEY

# BASE DE DATOS
DATABASE_URL=postgresql+psycopg://USUARIO:CONTRASEÑA@HOST:PUERTO/postgres?sslmode=require

# CORS
FRONTEND_URL=http://localhost:5173
# JWT / SESIÓN (generar JWT_SECRET con: python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET=CAMBIA_ESTO_POR_UN_SECRETO_LARGO
JWT_ALGORITHM=HS256
SESSION_INACTIVITY_MINUTES=30
SESSION_MAX_HOURS=12